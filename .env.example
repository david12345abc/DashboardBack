# Legacy SMB credentials (unused by native restore; kept for optional scripts).
LOGIN=DOMAIN\username
PASSWORD=replace_me
SMB_SHARE=\\srv2\copy1cbase

# Native Microsoft SQL Server restore (local instance, no Docker).
MSSQL_DB_NAME=erp_pm
MSSQL_HOST_PORT=1433
MSSQL_BAK_SOURCE=Z:\
MSSQL_BAK_DEST=D:\
MSSQL_DATA_DIR=D:/mssql/data
MSSQL_INCOMING_DIR=D:/mssql/incoming
# Text logs from the restore scripts (not SQL .ldf files).
MSSQL_LOG_DIR=D:/mssql/logs
# Permanent SQL Server transaction-log directory (.ldf) on C:.
MSSQL_LOG_DATA_DIR=C:/mssql/logdata
MSSQL_STATE_FILE=D:/mssql/state.json
# Optional absolute path to sqlcmd.exe
# MSSQL_SQLCMD=C:/Program Files/Microsoft SQL Server/Client SDK/ODBC/170/Tools/Binn/SQLCMD.EXE

# Kill-switch: 1 = refuse restore. Marker file D:\mssql\RESTORE_DISABLED also works.
MSSQL_RESTORE_DISABLED=0
# Django daemon scheduler (DashboardBack getkpi.apps).
MSSQL_RESTORE_SCHEDULER_ENABLED=1
MSSQL_RESTORE_HOUR=21
MSSQL_RESTORE_MINUTE=0

# Служебные параметры восстановления.
BACKUP_MIN_AGE_MINUTES=5
# Client/sqlcmd budget for long operations (48h). A timeout must not restart RESTORE.
RESTORE_TIMEOUT_SECONDS=172800
# Separate ceiling for poll-until-ONLINE after client disconnect (72h).
RESTORE_POLL_TIMEOUT_SECONDS=259200

# Runtime SQL connection used by dashboard / comdir (Trusted Connection).
SQL_SERVER=.
SQL_USER=DOMAIN\username
SQL_PASSWORD=replace_me
# SQL_DATABASE=erp_pm
# SQL_DRIVER=ODBC Driver 17 for SQL Server

# LM Studio (OpenAI-compatible local API).
LM_STUDIO_BASE_URL=http://192.168.1.157:1234/v1
LM_STUDIO_MODEL=qwen3-vl-8b-thinking
# GGUF embedder for /api/lmstudio/v1/embeddings/ (LM Studio key/id, not HF repo path).
# HF: https://huggingface.co/Content-AI/USER-bge-m3-Q8_0-GGUF
LM_STUDIO_EMBEDDING_MODEL=text-embedding-user-bge-m3
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_TIMEOUT_SECONDS=180
LM_STUDIO_AUTO_LOAD_MODEL=1
LM_STUDIO_CONTEXT_LENGTH=32768
LM_STUDIO_EMBEDDING_CONTEXT_LENGTH=8192
