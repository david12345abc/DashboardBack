# Доступ к сетевой папке с резервными копиями 1С.
LOGIN=DOMAIN\username
PASSWORD=replace_me
SMB_SHARE=\\srv2\copy1cbase

# Локальный Microsoft SQL Server.
MSSQL_SA_PASSWORD=replace_with_a_strong_password
MSSQL_DB_NAME=erp_pm
MSSQL_HOST_PORT=1433
MSSQL_DATA_DIR=D:/mssql/data
MSSQL_INCOMING_DIR=D:/mssql/incoming
# Text logs from the restore scripts (not SQL .ldf files).
MSSQL_LOG_DIR=D:/mssql/logs
# Permanent SQL Server transaction-log directory (.ldf) on C:.
MSSQL_LOG_DATA_DIR=C:/mssql/log
MSSQL_STATE_FILE=D:/mssql/state.json

# Служебные параметры восстановления.
BACKUP_MIN_AGE_MINUTES=5
# Client/sqlcmd budget for long operations (48h). A timeout must not restart RESTORE.
RESTORE_TIMEOUT_SECONDS=172800
# Separate ceiling for poll-until-ONLINE after client disconnect (72h).
RESTORE_POLL_TIMEOUT_SECONDS=259200
